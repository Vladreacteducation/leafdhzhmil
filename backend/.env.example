PORT=3000
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=dzhmil_system_db

# External Matomo analytics DB #1 (read-only usage)
MATOMO_DB_HOST=
MATOMO_DB_PORT=3306
MATOMO_DB_USER=
MATOMO_DB_PASSWORD=
MATOMO_DB_NAME=
MATOMO_TABLE_PREFIX=matomo_
# MATOMO_LABEL=Matomo 1
# Timezone every site in THIS instance uses (check matomo_site.timezone — it's
# normally the same for every site in one installation). "America/Chicago" or
# a fixed offset like "UTC-4" both work. Defaults to UTC if unset, which will
# NOT match the native Matomo UI's day/period boundaries for non-UTC sites.
# MATOMO_TIMEZONE=America/Chicago

# Optional: a second, independent Matomo installation — same variables with a
# "2" suffix. Leave MATOMO2_DB_HOST empty/unset to run with just one instance.
MATOMO2_DB_HOST=
MATOMO2_DB_PORT=3306
MATOMO2_DB_USER=
MATOMO2_DB_PASSWORD=
MATOMO2_DB_NAME=
MATOMO2_TABLE_PREFIX=matomo_
# MATOMO2_LABEL=Matomo 2
# MATOMO2_TIMEZONE=UTC-4
